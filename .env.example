# Переменные для функций из api/. На Vercel они задаются в
# Settings → Environment Variables, а не в файле. Этот файл — только образец:
# настоящие значения в репозиторий не попадают.

# Токен бота от @BotFather. Им проверяется подпись входа и им же бот пишет
# уведомления. Без него вход невозможен, а кабинет останется доступен только
# в демо-режиме (/lk/?demo=1).
TELEGRAM_BOT_TOKEN=""

# Имя бота без @ — его требует виджет входа. В BotFather нужно ещё выполнить
# /setdomain и указать домен сайта, иначе кнопка не отрисуется.
TELEGRAM_BOT_USERNAME=""

# Секрет вебхука: им закрыт адрес /api/tg/webhook/, на который стучится
# Telegram при входе через приложение. Только латиница, цифры и знаки —
# значение едет в HTTP-заголовке. Придумать: node tools/set-webhook.mjs --secret
# Привязать вебхук: node --env-file=.env tools/set-webhook.mjs
# Без него вход по ссылке на бота не работает, виджет по номеру — работает.
TELEGRAM_WEBHOOK_SECRET=""

# Upstash Redis по REST. Если обе переменные пустые, хранилище работает
# в памяти процесса: так запускается npm run serve локально и так же
# работают тесты. На Vercel память между вызовами не живёт, поэтому там
# переменные обязательны.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Свой адрес. Сверяется с Origin на всех изменяющих запросах и определяет,
# ставить ли куке флаг Secure.
SITE_ORIGIN="https://peresmenka.vercel.app"

# Произвольная длинная строка. Без неё /api/cron/match отвечает 401.
# Vercel Cron передаёт её заголовком Authorization: Bearer <значение>.
CRON_SECRET=""
